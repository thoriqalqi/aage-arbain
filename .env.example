# Salin ke apps/api/.env (dev lokal) atau .env di root (docker compose). JANGAN commit file .env.

# Database. API hanya mau start pada database online.
# IZINKAN_DB_LOKAL=true membolehkan SQLite atau Postgres lokal, hanya untuk pengembangan dan tes.
# IZINKAN_DB_LOKAL=true
# DATABASE_URL=postgresql+psycopg://aage:aage@localhost:5432/aage
# Supabase: salin dari Connect, lalu ikuti docs/DATABASE_ONLINE.md. Wajib ?sslmode=require.
# DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:SANDI@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require

# Alamat situs resmi mitra untuk JSON-LD Studio Konten. Kosong = tidak disebut.
# SITUS_RESMI=https://domain-resmi-mitra
# Pola alamat halaman produk untuk saran internal link, memuat {sku} atau {slug}. Kosong = saran tanpa alamat.
# POLA_URL_PRODUK=https://domain-resmi-mitra/produk/{slug}

# Wajib diganti di server (min. 32 karakter acak)
JWT_SECRET=

# LLM: Gemini REST langsung (kosongkan key = mode offline deterministik, tetap bisa demo).
# Cek nama model yang tersedia untuk key Anda di Google AI Studio.
GEMINI_API_KEY=
LLM_MODEL=gemini/<model-flash>
LLM_JUDGE_MODEL=gemini/<model-flash>
LLM_FALLBACK_MODELS=
LLM_TIMEOUT_S=30
# Gaya bahasa LLM dengan kunci fakta (false = balasan template apa adanya) & retensi memori ringkasan percakapan
LLM_GAYA=true
MEMORI_RETENSI_HARI=30
# Harga per 1 juta token (USD) untuk budget cap; sesuaikan dengan model
LLM_PRICE_IN_USD_PER_M=0.30
LLM_PRICE_OUT_USD_PER_M=2.50
BUDGET_DAILY_RP=25000
BUDGET_MONTHLY_RP=500000

# Multi-agent CrewAI (src/agents_crew.py). Tanpa ANTHROPIC_API_KEY → mode simulasi (tool deterministik, tanpa LLM)
ANTHROPIC_API_KEY=
AGENT_MODEL=anthropic/claude-sonnet-5-5
AGENT_MODE=auto

# Fonnte (gateway WhatsApp) untuk kirim invoice yang disetujui staf; kosong = simulasi
FONNTE_TOKEN=

# Observability opsional (Langfuse self-host)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# WhatsApp Cloud API (nomor uji Meta)
WA_VERIFY_TOKEN=aage-verify
WA_APP_SECRET=
WA_ACCESS_TOKEN=
WA_PHONE_NUMBER_ID=
WA_REMINDER_TEMPLATE=

# Penyedia WhatsApp: meta | wati | kosong = otomatis (wati bila WATI_API_KEY terisi)
WA_PROVIDER=

# WATI API v3 — key dari dashboard WATI (API Docs), dikirim sebagai Bearer token
WATI_API_KEY=
WATI_BASE_URL=https://live-mt-server.wati.io/api/ext/v3
# Token rahasia acak; daftarkan webhook di WATI: https://<domain>/api/webhook/wati?token=<WATI_WEBHOOK_TOKEN>
WATI_WEBHOOK_TOKEN=
# Opsional untuk akun multi-nomor (target "Channel:PhoneNumber")
WATI_CHANNEL_NUMBER=
# Masa uji: hanya nomor ini yang benar-benar dikirimi balasan (pisahkan koma). Kosongkan saat siap ke pelanggan.
WATI_ALLOWLIST=

# Telegram Bot API — jalur uji live sebelum WhatsApp (docs/UJI_TELEGRAM.md). Token dari @BotFather.
TELEGRAM_BOT_TOKEN=
# String acak (A-Z a-z 0-9 _ -); didaftarkan lewat: python scripts/telegram_bot.py set-webhook <URL publik>
TELEGRAM_WEBHOOK_SECRET=
# Masa uji: hanya chat id ini yang diproses & dibalas (pisahkan koma). Cek id: python scripts/telegram_bot.py chat-id
TELEGRAM_ALLOWLIST=

# Prospek — Live Lead Scouting OpenStreetMap Overpass (gratis, tanpa API key) + Opportunity Score
OVERPASS_URLS=https://overpass-api.de/api/interpreter,https://overpass.private.coffee/api/interpreter
OVERPASS_TIMEOUT_S=25
PROSPEK_MAX_RESULTS=100
GUDANG_LAT=-6.9932
GUDANG_LNG=110.4203
SKOR_ZONA_EMAS_MIN_KM=2
SKOR_ZONA_EMAS_MAX_KM=8
SKOR_JARAK_NOL_KM=30
SKOR_GEO_DI_GUDANG=35
# Live AI Search Audit di tab Prospek (berita Google via serper.dev); kosong = tidak terhubung
SERPER_API_KEY=

CORS_ORIGINS=http://localhost:3000
